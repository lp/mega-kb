{
  "name": "mega-support-kb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Svelte 5 and mdsvex support KB. Use mise run setup, mise run dev, or mise run build; portable HTML is written to rendered/.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:client && npm run render",
    "build:client": "vite build",
    "render": "vite build --ssr src/entry-server.ts --outDir .render-build && node scripts/render.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "mdsvex": "^0.12.6",
    "svelte": "^5.39.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
